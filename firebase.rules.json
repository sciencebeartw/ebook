      ".read": true,
      ".write": false
    },

    // =============================================
    // 家長回饋/留言 - 所有人可讀寫（家長端也要能提交）
    // =============================================
    "feedbacks": {
      ".read": true,
      ".write": true
    },

    // =============================================
    // 學費單資料 - 只允許後台讀取（暫時全開，正式上線前要改）
