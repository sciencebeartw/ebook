    "bills": {
      ".read": true,
      ".write": false
    },

    // =============================================
    // 每日聯絡簿 - 所有人可讀，只有後台可寫
    // =============================================
    "dailyPosts": {
      ".read": true,
      ".write": false
    },

    // =============================================
    // 班級公告 - 所有人可讀，只有後台可寫
    // =============================================
    "bulletins": {
      ".read": true,
      ".write": false
    }
