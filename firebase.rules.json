{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "admins": {
      ".read": true,
      ".write": true
    },

    // =============================================
    // 多學科命名空間 (Science / Math / etc.)
    // =============================================
    "$subject": {
      // =============================================
      // 學生資料 - 所有人可讀（前端靠密碼保護）
      // =============================================
      "students": {
        ".read": true,
        ".write": false
      },

      // =============================================
      // 班級公告與聯絡簿 - 所有人可讀，只有後台可寫
      // =============================================
      "classes": {
        ".read": true,
        ".write": false
      },

      // =============================================
      // 成績資料 - 所有人可讀
      // =============================================
      "grades": {
        ".read": true,
        ".write": false
      },

      // =============================================
      // 家長回饋/留言 - 所有人可讀寫
      // =============================================
      "feedbacks": {
        ".read": true,
        ".write": true
      },

      // =============================================
      // 每日聯絡簿 - 所有人可讀
      // =============================================
      "dailyPosts": {
        ".read": true,
        ".write": false
      },

      // =============================================
      // 班級公告 - 所有人可讀
      // =============================================
      "bulletins": {
        ".read": true,
        ".write": false
      }
    },

    // =============================================
    // 相容性保留：原本根目錄的路徑
    // =============================================
    "students": { ".read": true, ".write": false },
    "grades": { ".read": true, ".write": false },
    "feedbacks": { ".read": true, ".write": true },
    "dailyPosts": { ".read": true, ".write": false },
    "bulletins": { ".read": true, ".write": false }
  }
}
